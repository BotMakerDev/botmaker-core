<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      groupId is com.github.BotMakerDev for the same reason as every other published module: JitPack serves
      this repo as com.github.BotMakerDev:botmaker-core:<tag> whatever this pom says. The version is real:
      -SNAPSHOT on main, the release version on a tag; only the release moves it (umbrella
      docs/refactor/43-real-versions.md).
    -->
    <groupId>com.github.BotMakerDev</groupId>
    <artifactId>botmaker-core</artifactId>
    <version>0.1.0</version>

    <name>BotMaker Core</name>
    <description>
        The headless process that owns an open bot: it opens the project, edits its Java, compiles and runs it, and
        serves the MCP. Studio is one client of it.
    </description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.2</junit.version>
        <!-- Kept in step with the cli's, the nearest copy among the upstreams. -->
        <jackson.version>2.17.2</jackson.version>
        <!-- The contract's, for compiling against its slot editors only. -->
        <javafx.version>27</javafx.version>
        <!-- Each upstream's main version; a release commit sets the released one (doc 43). -->
        <botmaker.studioapi.version>v0.17.0</botmaker.studioapi.version>
        <botmaker.java.version>v0.2.0</botmaker.java.version>
        <botmaker.pluginhost.version>v0.12.0</botmaker.pluginhost.version>
        <botmaker.runlog.version>v0.1.0</botmaker.runlog.version>
        <botmaker.cli.version>v0.12.0</botmaker.cli.version>
        <botmaker.shared.version>v0.8.0</botmaker.shared.version>
        <botmaker.session.version>v0.7.0</botmaker.session.version>
        <mcp.version>2.1.0</mcp.version>
        <jetty.version>12.1.14</jetty.version>
    </properties>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- The contract at compile scope: the core is a host, like Studio, and loads the bot's plugins against
             this one copy. botmaker-java and botmaker-plugin-host have it `provided`. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-studio-api</artifactId>
            <version>${botmaker.studioapi.version}</version>
        </dependency>

        <!-- The bot's Java: parse, edit and the value grammar. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-java</artifactId>
            <version>${botmaker.java.version}</version>
        </dependency>

        <!-- The plugin loader over the project's resolved classpath. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-plugin-host</artifactId>
            <version>${botmaker.pluginhost.version}</version>
        </dependency>

        <!-- A run's run.jsonl, its writer and readers. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-runlog</artifactId>
            <version>${botmaker.runlog.version}</version>
        </dependency>

        <!-- The cli's main jar, a silent library: publish, the catalog, repair. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-cli</artifactId>
            <version>${botmaker.cli.version}</version>
        </dependency>

        <!-- The host platform (windows, capture, GitHub) and private display sessions, for runs. -->
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-shared</artifactId>
            <version>${botmaker.shared.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.BotMakerDev</groupId>
            <artifactId>botmaker-session</artifactId>
            <version>${botmaker.session.version}</version>
        </dependency>

        <!-- The project's Maven model and its resolver (MavenService, 2026-11-05), the versions Studio pinned. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-model</artifactId>
            <version>3.10.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-resolver-provider</artifactId>
            <version>3.10.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.resolver</groupId>
            <artifactId>maven-resolver-supplier-mvn3</artifactId>
            <version>2.0.24</version>
        </dependency>

        <!-- MCP: the assistant tools served to any MCP client (assist/McpEndpoint, from Studio on 2026-11-05).
             mcp-core plus the Jackson 2 mapper rather than the `mcp` bundle, which brings Jackson 3 beside
             the Jackson 2 everything else here uses. Its streamable-HTTP transport is a servlet, so Jetty
             (ee11 = Servlet 6.1, what the SDK compiles against) hosts it on 127.0.0.1 only. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp.version}</version>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>${mcp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.ee11</groupId>
            <artifactId>jetty-ee11-servlet</artifactId>
            <version>${jetty.version}</version>
        </dependency>

        <!-- JGit: the project's own history and its sharing (project/vcs, sharing), no system git. -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>7.8.0.202609011348-r</version>
        </dependency>

        <!-- ClassGraph: a library's classes and their docs, read from its jars (index, nav). -->
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
            <version>6.0.0</version>
        </dependency>

        <!-- LSP4J: a compile problem is a Diagnostic (validation). -->
        <dependency>
            <groupId>org.eclipse.lsp4j</groupId>
            <artifactId>org.eclipse.lsp4j</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Compile-only, as in the cli, and it stays (2026-11-05, phase 8a): the contract's signatures name JavaFX types.
             PluginHost binds a plugin's slot editors, whose methods return javafx.scene.Node, and HostServices
             implements StudioServices, whose Theme and Dialogs name Scene and Window. The core imports no javafx
             itself (CoreLayersTest) and constructs no Node; a window comes through plugin.UiPort. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- What the resolver and JGit log through, at the version Studio's binding brings; the binding is the
             application's to choose. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.20</version>
        </dependency>

        <!-- The protocol's JSON (CoreJson). -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Pinned for JitPack: its Maven defaults the compiler plugin to 3.1, which ignores
                 maven.compiler.release. 3.11.0 because 3.12.0 needs a newer Maven than JitPack's
                 (botmaker-studio-api/pom.xml has the full account). -parameters: Jackson reads a record's
                 components by name either way, and plugins' factories need it in phase 8. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <!-- As in Studio: everything a test may write stays in target/, so no test can touch the developer's
                     cache (the jar index and its sweep, the GitHub credentials), config or preferences. -->
                <configuration>
                    <argLine>-Djava.util.prefs.userRoot=${project.build.directory}/test-prefs-${surefire.forkNumber}</argLine>
                    <systemPropertyVariables>
                        <botmaker.config.dir>${project.build.directory}/test-config-${surefire.forkNumber}</botmaker.config.dir>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <XDG_CACHE_HOME>${project.build.directory}/test-cache-${surefire.forkNumber}</XDG_CACHE_HOME>
                        <LOCALAPPDATA>${project.build.directory}/test-cache-${surefire.forkNumber}</LOCALAPPDATA>
                    </environmentVariables>
                </configuration>
            </plugin>
            <!-- The tests jar: TestPlugins, the in-memory plugins Studio's own tests load too, and the other helpers
                 they share (2026-11-05). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Bakes every ${botmaker.*.version} into the published pom. flattenMode=oss strips the jitpack
                 repository unless kept. 1.4.1 for JitPack's Maven (botmaker-plugin-toolkit/pom.xml). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.4.1</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <pomElements>
                        <repositories>keep</repositories>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
